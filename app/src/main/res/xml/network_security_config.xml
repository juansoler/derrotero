<?xml version="1.0" encoding="utf-8"?>
<!-- SignalK servers on the boat LAN are usually plain HTTP/WS, so allow cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
